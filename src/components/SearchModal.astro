---
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/*
  This lives at the end of <body>, never inside the navbar: the navbar sets
  `backdrop-filter`, which makes it the containing block for any fixed-position
  descendant, so the dialog's backdrop got clipped to the navbar's strip.
*/}
<div
  id="search-modal"
  class="search-modal"
  data-lang={lang}
  data-empty={t('search.empty')}
  data-suggestions={t('search.suggestions')}
  data-loading={t('search.loading')}
  data-noresults={t('search.noResults')}
  data-noresults-hint={t('search.noResultsHint')}
  data-count-one={t('search.count.one')}
  data-count-many={t('search.count.many')}
  data-cat-project={t('search.cat.project')}
  data-cat-blog={t('search.cat.blog')}
  data-cat-page={t('search.cat.page')}
>
  <div class="search-backdrop" data-search-dismiss></div>

  <div class="search-panel" role="dialog" aria-modal="true" aria-label={t('search.label')}>
    <div class="search-field">
      <svg class="search-field-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="8.75" cy="8.75" r="5.75" fill="none" stroke="currentColor" stroke-width="1.9" />
        <path d="m13.2 13.2 4 4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
      </svg>

      <input
        id="search-input"
        class="search-input"
        type="text"
        role="combobox"
        placeholder={t('search.placeholder')}
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label={t('search.placeholder')}
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
      />

      <button id="search-clear" class="search-icon-btn search-clear" type="button" aria-label={t('search.clear')} hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="7" fill="currentColor" opacity="0.14" />
          <path d="m5.5 5.5 5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>

      <button id="search-close" class="search-icon-btn search-close" type="button" aria-label={t('search.close')}>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="m4 4 8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div id="search-results" class="search-results" role="listbox" aria-label={t('search.label')}></div>

    <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>

    <div class="search-footer">
      <span class="search-hints">
        <span class="search-hint"><kbd>↑</kbd><kbd>↓</kbd> {t('search.kbd.navigate')}</span>
        <span class="search-hint search-hint--enter"><kbd>↵</kbd> {t('search.kbd.open')}</span>
        <span class="search-hint"><kbd>esc</kbd> {t('search.kbd.close')}</span>
      </span>
      <span class="search-brand">Alex<span>DevFlow</span></span>
    </div>
  </div>
</div>

<script>
  type Category = 'project' | 'blog' | 'page';

  type SearchRecord = {
    title: string;
    excerpt: string;
    body: string;
    tags: string[];
    url: string;
    lang: string;
    category: Category;
  };

  const modal = document.getElementById('search-modal');
  const panel = modal?.querySelector('.search-panel') as HTMLElement | null | undefined;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results');
  const statusEl = document.getElementById('search-status');
  const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('search-close');
  const toggle = document.getElementById('search-toggle');

  if (modal && panel && input && resultsEl) {
    const data = modal.dataset;
    const labels = {
      empty: data.empty || '',
      suggestions: data.suggestions || 'Suggestions',
      loading: data.loading || 'Loading…',
      noResults: data.noresults || 'No results for',
      noResultsHint: data.noresultsHint || '',
      countOne: data.countOne || 'result',
      countMany: data.countMany || 'results',
      cat: {
        project: data.catProject || 'Project',
        blog: data.catBlog || 'Blog',
        page: data.catPage || 'Page',
      } as Record<Category, string>,
    };
    const lang = data.lang || 'en';

    let index: SearchRecord[] | null = null;
    let loadPromise: Promise<SearchRecord[]> | null = null;
    let options: HTMLElement[] = [];
    let activeIndex = -1;
    let lastFocused: HTMLElement | null = null;

    /* ---------------------------------------------------------- data ---- */

    function loadIndex(): Promise<SearchRecord[]> {
      if (loadPromise) return loadPromise;
      loadPromise = fetch('/search-index.json')
        .then((r) => (r.ok ? r.json() : []))
        .then((rows: SearchRecord[]) => {
          // Current language, plus the blog, which is only written in English.
          index = rows.filter((r) => r.lang === lang || r.category === 'blog');
          return index;
        })
        .catch(() => {
          index = [];
          return index;
        });
      return loadPromise;
    }

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

    const escapeReg = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    function highlight(text: string, terms: string[]): string {
      let out = escapeHtml(text);
      for (const term of terms) {
        if (term.length < 2) continue;
        out = out.replace(new RegExp(`(${escapeReg(escapeHtml(term))})`, 'gi'), '<mark>$1</mark>');
      }
      return out;
    }

    /** A short excerpt centred on the first matched term. */
    function snippet(body: string, terms: string[]): string {
      const lower = body.toLowerCase();
      let pos = -1;
      for (const term of terms) {
        const i = lower.indexOf(term);
        if (i !== -1 && (pos === -1 || i < pos)) pos = i;
      }
      if (pos === -1) return body.slice(0, 150);
      const start = Math.max(0, pos - 55);
      const end = Math.min(body.length, pos + 115);
      return (start > 0 ? '… ' : '') + body.slice(start, end) + (end < body.length ? ' …' : '');
    }

    function score(rec: SearchRecord, terms: string[]): number {
      const title = rec.title.toLowerCase();
      const tags = rec.tags.join(' ').toLowerCase();
      const excerpt = rec.excerpt.toLowerCase();
      const body = rec.body.toLowerCase();
      let total = 0;
      for (const term of terms) {
        let s = 0;
        if (title.includes(term)) s += 10;
        if (title.startsWith(term)) s += 6;
        if (tags.includes(term)) s += 6;
        if (excerpt.includes(term)) s += 3;
        s += Math.min(body.split(term).length - 1, 5);
        if (s === 0) return 0; // every term must match somewhere (AND search)
        total += s;
      }
      return total;
    }

    /* -------------------------------------------------------- render ---- */

    /** `terms` empty means this is a suggestion: a place to go, so title only. */
    function resultMarkup(rec: SearchRecord, terms: string[], i: number): string {
      const cat = labels.cat[rec.category] || rec.category;
      const excerpt = terms.length
        ? `<span class="search-result-excerpt">${highlight(snippet(rec.body || rec.excerpt, terms), terms)}</span>`
        : '';
      return `
        <a class="search-result${terms.length ? '' : ' search-result--compact'}" id="search-opt-${i}" role="option" aria-selected="false" tabindex="-1" href="${escapeHtml(rec.url)}">
          <span class="search-result-head">
            <span class="search-result-title">${highlight(rec.title, terms)}</span>
            <span class="search-result-cat search-result-cat--${escapeHtml(rec.category)}">${escapeHtml(cat)}</span>
          </span>
          ${excerpt}
          <svg class="search-result-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>`;
    }

    /** With no query, offer somewhere to go rather than an empty box. */
    function suggestions(): SearchRecord[] {
      if (!index) return [];
      const rank: Record<Category, number> = { page: 0, blog: 1, project: 2 };
      return [...index].sort((a, b) => rank[a.category] - rank[b.category]).slice(0, 5);
    }

    function setStatus(text: string) {
      if (statusEl) statusEl.textContent = text;
    }

    function collectOptions() {
      options = Array.from(resultsEl!.querySelectorAll('.search-result')) as HTMLElement[];
      input!.setAttribute('aria-expanded', options.length ? 'true' : 'false');
      setActive(options.length ? 0 : -1, false);
    }

    function setActive(next: number, scroll = true) {
      options.forEach((el, i) => {
        const on = i === next;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-selected', String(on));
      });
      activeIndex = next;

      const current = options[next];
      if (current) {
        input!.setAttribute('aria-activedescendant', current.id);
        if (scroll) current.scrollIntoView({ block: 'nearest' });
      } else {
        input!.removeAttribute('aria-activedescendant');
      }
    }

    function render(query: string) {
      const q = query.trim().toLowerCase();
      clearBtn?.toggleAttribute('hidden', q.length === 0);

      if (!index) {
        resultsEl!.innerHTML = `<p class="search-state" role="presentation">${escapeHtml(labels.loading)}</p>`;
        collectOptions();
        return;
      }

      if (!q) {
        const picks = suggestions();
        resultsEl!.innerHTML = picks.length
          ? `<p class="search-group" role="presentation">${escapeHtml(labels.suggestions)}</p>` +
            picks.map((rec, i) => resultMarkup(rec, [], i)).join('')
          : `<p class="search-state" role="presentation">${escapeHtml(labels.empty)}</p>`;
        collectOptions();
        setStatus('');
        return;
      }

      const terms = q.split(/\s+/).filter(Boolean);
      const ranked = index
        .map((rec) => ({ rec, s: score(rec, terms) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 8);

      if (!ranked.length) {
        resultsEl!.innerHTML =
          `<p class="search-state search-state--empty" role="presentation">` +
          `<strong>${escapeHtml(labels.noResults)} “${escapeHtml(query.trim())}”</strong>` +
          `<span>${escapeHtml(labels.noResultsHint)}</span></p>`;
        collectOptions();
        setStatus(`${labels.noResults} ${query.trim()}`);
        return;
      }

      const count = ranked.length;
      resultsEl!.innerHTML =
        `<p class="search-group" role="presentation">${count} ${escapeHtml(count === 1 ? labels.countOne : labels.countMany)}</p>` +
        ranked.map(({ rec }, i) => resultMarkup(rec, terms, i)).join('');
      collectOptions();
      setStatus(`${count} ${count === 1 ? labels.countOne : labels.countMany}`);
    }

    /* ------------------------------------------------- open and close ---- */

    function lockScroll(on: boolean) {
      const root = document.documentElement;
      if (on) {
        const gap = window.innerWidth - root.clientWidth;
        root.style.setProperty('--scrollbar-comp', `${gap}px`);
        root.classList.add('search-open');
      } else {
        root.classList.remove('search-open');
        root.style.removeProperty('--scrollbar-comp');
      }
    }

    const isOpen = () => modal!.classList.contains('active');

    function openSearch() {
      if (isOpen()) return;
      lastFocused = document.activeElement as HTMLElement | null;
      modal!.classList.add('active');
      lockScroll(true);
      render(input!.value);
      loadIndex().then(() => {
        if (isOpen()) render(input!.value);
      });
      requestAnimationFrame(() => input!.focus());
    }

    function closeSearch() {
      if (!isOpen()) return;
      modal!.classList.remove('active');
      lockScroll(false);
      input!.setAttribute('aria-expanded', 'false');
      input!.removeAttribute('aria-activedescendant');
      setStatus('');
      (lastFocused ?? toggle)?.focus?.();
    }

    /* ------------------------------------------------------- wiring ----- */

    let debounce: ReturnType<typeof setTimeout> | null = null;
    input.addEventListener('input', () => {
      if (debounce) clearTimeout(debounce);
      debounce = setTimeout(() => render(input.value), 90);
    });

    toggle?.addEventListener('click', openSearch);
    // Warm the index while the pointer is still travelling to the button.
    toggle?.addEventListener('pointerenter', () => void loadIndex(), { once: true });
    closeBtn?.addEventListener('click', closeSearch);
    modal.querySelector('[data-search-dismiss]')?.addEventListener('click', closeSearch);

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      render('');
      input.focus();
    });

    // Pointer and keyboard share one notion of "the active result".
    resultsEl.addEventListener('pointermove', (event) => {
      const option = (event.target as Element | null)?.closest('.search-result') as HTMLElement | null | undefined;
      if (!option) return;
      const i = options.indexOf(option);
      if (i !== -1 && i !== activeIndex) setActive(i, false);
    });

    input.addEventListener('keydown', (event) => {
      if (!options.length) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive((activeIndex + 1) % options.length);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive((activeIndex - 1 + options.length) % options.length);
      } else if (event.key === 'Home') {
        event.preventDefault();
        setActive(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        setActive(options.length - 1);
      } else if (event.key === 'Enter') {
        const current = options[activeIndex] as HTMLAnchorElement | undefined;
        if (current) {
          event.preventDefault();
          current.click();
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      const shortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
      if (shortcut) {
        event.preventDefault();
        isOpen() ? closeSearch() : openSearch();
        return;
      }
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeSearch();
        return;
      }

      // Keep Tab inside the dialog.
      if (event.key === 'Tab') {
        const focusable = (
          Array.from(panel!.querySelectorAll('input, button:not([hidden])')) as HTMLElement[]
        ).filter((el) => !el.hasAttribute('hidden'));
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // The trigger's shortcut hint should name the key this machine actually uses.
    const isApple = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll('[data-search-shortcut]').forEach((el) => {
      el.textContent = isApple ? '⌘K' : 'Ctrl K';
    });
  }
</script>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Scroll lock, with the scrollbar's width given back so nothing shifts. */
  html.search-open body {
    overflow: hidden;
    padding-right: var(--scrollbar-comp, 0px);
  }

  html.search-open .navbar {
    padding-right: calc(2rem + var(--scrollbar-comp, 0px));
  }

  /* ---------------------------------------------------------- shell ---- */

  .search-modal {
    /* The field is the one thing here you type into and select from. */
    -webkit-user-select: none;
    user-select: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(3.5rem, 12vh, 8rem) 1rem 2rem;
    visibility: hidden;
    pointer-events: none;
  }

  .search-modal.active {
    visibility: visible;
    pointer-events: auto;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 22, 16, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.22s ease;
  }

  .search-modal.active .search-backdrop {
    opacity: 1;
  }

  .search-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 620px;
    max-height: min(32rem, 72vh);
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 16px;
    box-shadow:
      0 32px 64px -16px rgba(0, 0, 0, 0.32),
      0 8px 24px -12px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    opacity: 0;
    transform: translateY(-10px) scale(0.985);
    transition: opacity 0.2s ease, transform 0.26s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-modal.active .search-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* ---------------------------------------------------------- field ---- */

  .search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    padding: 14px 14px 14px 18px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  .search-field-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    color: var(--accent-strong);
  }

  .search-input {
    -webkit-user-select: text;
    user-select: text;
    flex: 1;
    min-width: 0;
    padding: 4px 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--primary-color);
    font-family: 'Roboto', sans-serif;
    font-size: 1.05rem;
    line-height: 1.4;
    appearance: none;
  }

  .search-input::placeholder {
    color: #a9a29a;
  }

  .search-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-color);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .search-icon-btn svg {
    width: 16px;
    height: 16px;
  }

  .search-icon-btn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: var(--primary-color);
  }

  .search-icon-btn:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 1px;
  }

  /* -------------------------------------------------------- results ---- */

  .search-results {
    flex: 1 1 auto;
    min-height: 0;
    padding: 6px;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .search-group {
    padding: 10px 12px 6px;
    color: var(--text-color);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    opacity: 0.6;
  }

  .search-state {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 32px 20px 36px;
    color: var(--text-color);
    text-align: center;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .search-state strong {
    color: var(--primary-color);
    font-weight: 600;
  }

  .search-state span {
    opacity: 0.75;
    font-size: 0.86rem;
  }

  .search-result {
    position: relative;
    display: block;
    padding: 11px 34px 12px 12px;
    border-radius: 10px;
    text-decoration: none;
    cursor: pointer;
  }

  .search-result--compact {
    padding-top: 9px;
    padding-bottom: 10px;
  }

  .search-result--compact .search-result-head {
    margin-bottom: 0;
  }

  .search-result.is-active {
    background: rgba(9, 167, 224, 0.1);
  }

  .search-result:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: -2px;
  }

  .search-result-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 3px;
  }

  .search-result-title {
    color: var(--primary-color);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .search-result-cat {
    flex-shrink: 0;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(9, 167, 224, 0.12);
    color: var(--accent-strong);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .search-result-cat--blog { background: rgba(155, 89, 182, 0.14); color: #8e44ad; }
  .search-result-cat--project { background: rgba(46, 204, 113, 0.16); color: #1e8c54; }

  .search-result-excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-color);
    font-size: 0.855rem;
    line-height: 1.5;
    opacity: 0.9;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .search-result-arrow {
    position: absolute;
    top: 14px;
    right: 12px;
    width: 15px;
    height: 15px;
    color: var(--accent-strong);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .search-result.is-active .search-result-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .search-result mark {
    padding: 0 2px;
    border-radius: 3px;
    background: rgba(9, 167, 224, 0.22);
    color: inherit;
    font-weight: 600;
  }

  /* --------------------------------------------------------- footer ---- */

  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-shrink: 0;
    padding: 9px 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.07);
    background: rgba(0, 0, 0, 0.015);
    color: var(--text-color);
    font-size: 0.75rem;
  }

  .search-hints {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    opacity: 0.75;
  }

  .search-hint {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .search-footer kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 5px;
    background: #fff;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.07);
    color: var(--primary-color);
    font-family: 'Roboto', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
  }

  .search-brand {
    flex-shrink: 0;
    color: var(--primary-color);
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    opacity: 0.45;
  }

