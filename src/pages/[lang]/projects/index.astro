---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, languages, type Lang } from '@/i18n';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const all = await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`));
const projects = all.sort((a, b) => a.data.order - b.data.order);

const closedSourceLabel = lang === 'it' ? 'Codice non pubblico' : 'Closed source';
---

<BaseLayout
  title={`${t('projects.title')} | Alessandro Trysh`}
  description={t('projects.subtitle')}
  lang={lang}
>
  <div class="projects-page">
    <header class="projects-page-header">
      <h1 class="projects-page-title">{t('projects.title')}</h1>
      <p class="projects-page-subtitle">{t('projects.subtitle')}</p>
    </header>

    <ul class="project-list">
      {projects.map((project) => {
        const slug = project.slug.split('/').pop();
        // Only a real app icon: the loose illustrations turn to mush at this size,
        // and they still run full width in the card fan on the portfolio page.
        const { title, description, icon, links, isClosedSource } = project.data;
        return (
          <li class="project-row" id={slug}>
            <div class="project-head">
              <div class="project-mark" aria-hidden="true">
                {icon ? (
                  <img
                    class="project-mark-img"
                    src={icon}
                    alt=""
                    width="256"
                    height="256"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="project-mark-monogram">{title.charAt(0).toUpperCase()}</span>
                )}
              </div>
              <h2 class="project-name">{title}</h2>
            </div>

            <p class="project-description">{description}</p>

            <div class="project-links">
              {links?.github && (
                <a class="project-link project-link--primary" href={links.github} data-repo={links.github}>
                  <i class="fas fa-code-branch" aria-hidden="true"></i>
                  <span>{t('projects.viewSource')}</span>
                  <span class="project-stars" hidden>
                    <i class="fas fa-star" aria-hidden="true"></i>
                    <span class="project-stars-count"></span>
                  </span>
                </a>
              )}
              {links?.custom && (
                <a class="project-link" href={links.custom.url}>
                  <i class={links.custom.icon || 'fas fa-link'} aria-hidden="true"></i>
                  <span>{links.custom.label}</span>
                </a>
              )}
              {links?.telegram && (
                <a class="project-link" href={links.telegram}>
                  <i class="fab fa-telegram" aria-hidden="true"></i>
                  <span>Telegram</span>
                </a>
              )}
              {links?.demo && (
                <a class="project-link" href={links.demo}>
                  <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  <span>{t('projects.demo')}</span>
                </a>
              )}
              {isClosedSource && (
                <span class="project-note">
                  <i class="fas fa-lock" aria-hidden="true"></i>
                  <span>{closedSourceLabel}</span>
                </span>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<script>
  // Star counts are decoration: if GitHub rate-limits us the link still stands.
  const links = document.querySelectorAll('[data-repo]');

  links.forEach(async (link) => {
    const repoUrl = (link as HTMLElement).dataset.repo;
    if (!repoUrl) return;

    let apiUrl: string;
    try {
      const url = new URL(repoUrl);
      const [owner, repo] = url.pathname.replace(/^\/|\/$/g, '').split('/');
      if (!owner || !repo) return;
      apiUrl = `https://api.github.com/repos/${owner}/${repo}`;
    } catch {
      return;
    }

    try {
      const response = await fetch(apiUrl);
      if (!response.ok) return;
      const data = await response.json();
      // A zero says nothing worth the space it takes.
      if (typeof data.stargazers_count !== 'number' || data.stargazers_count < 1) return;

      const holder = link.querySelector('.project-stars');
      const count = link.querySelector('.project-stars-count');
      if (!holder || !count) return;
      count.textContent = String(data.stargazers_count);
      holder.removeAttribute('hidden');
    } catch {
      // Offline or rate-limited: leave the link as it is.
    }
  });
</script>

<style>
  .projects-page {
    min-height: 100vh;
    padding-top: 100px;
    background: var(--primary-bg);
  }

  .projects-page-header {
    padding: 40px 20px 48px;
    text-align: center;
  }

  .projects-page-title {
    margin-bottom: 12px;
    color: var(--primary-color);
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
  }

  .projects-page-subtitle {
    max-width: 640px;
    margin: 0 auto;
    color: var(--text-color);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px 80px;
    list-style: none;
  }

  .project-row {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-row:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  }

  /* Arriving here from a card in the fan: clear the fixed navbar, and say
     which one you came for. */
  .project-row {
    scroll-margin-top: 96px;
  }

  .project-row:target {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12), 0 0 0 2px var(--accent-strong);
  }

  /* ------------------------------------------------------------ head ---- */

  .project-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .project-mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
  }

  .project-mark-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-mark-monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    background: rgba(9, 167, 224, 0.1);
    color: var(--accent-strong);
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .project-name {
    min-width: 0;
    color: var(--primary-color);
    font-family: 'Montserrat', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  /* ------------------------------------------------------------ body ---- */

  .project-description {
    margin-bottom: 20px;
    color: var(--text-color);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ----------------------------------------------------------- links ---- */

  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }

  .project-link,
  .project-note {
    -webkit-user-select: none;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .project-link {
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: transparent;
    color: var(--primary-color);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .project-link:hover {
    border-color: var(--accent-strong);
    color: var(--accent-strong);
    transform: translateY(-1px);
  }

  .project-link--primary {
    border-color: transparent;
    background: var(--button-bg);
    color: white;
  }

  .project-link--primary:hover {
    background: var(--button-hover);
    border-color: transparent;
    color: white;
  }

  .project-link:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .project-note {
    background: rgba(0, 0, 0, 0.05);
    color: var(--text-color);
    font-weight: 500;
  }

  .project-stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 2px;
    padding-left: 9px;
    border-left: 1px solid rgba(255, 255, 255, 0.36);
    font-size: 0.8rem;
  }

  .project-stars[hidden] {
    display: none;
  }

  @media (max-width: 1100px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
      max-width: 820px;
    }
  }

  /* ---------------------------------------------------------- mobile ---- */

  @media (max-width: 680px) {
    .project-list {
      grid-template-columns: 1fr;
      max-width: 520px;
    }

    .project-row {
      padding: 22px;
    }

    .project-link,
    .project-note {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row,
    .project-link {
      transition: none;
    }

    .project-row:hover,
    .project-link:hover {
      transform: none;
    }
  }
</style>
